<Window x:Class="Orts.Launcher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Open Rails"
        Width="1180" Height="760"
        MinWidth="900" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBackgroundBrush}"
        Foreground="{StaticResource PrimaryTextBrush}"
        FontFamily="Segoe UI"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display">
    <Window.Resources>
        <Style x:Key="RouteItemContainer" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Root"
                                Background="Transparent"
                                CornerRadius="8"
                                BorderThickness="1"
                                BorderBrush="Transparent">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#202020" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="Root" Property="Background" Value="#1B2430" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BadgeBorder" TargetType="Border">
            <Setter Property="Background" Value="#1B2430" />
            <Setter Property="BorderBrush" Value="{StaticResource PanelBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="10,3" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>

        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
        </Style>

        <Style x:Key="CardBorder" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SurfaceAltBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource PanelBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="16" />
            <Setter Property="Margin" Value="0,0,0,14" />
        </Style>

        <!-- A ListBox used as a radio group: this is the pill look for the environment choices. -->
        <Style x:Key="PillItemContainer" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd"
                                Background="{StaticResource SurfaceBrush}"
                                BorderBrush="{StaticResource PanelBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="16"
                                Padding="12,5">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource PanelBorderBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentHoverBrush}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentHoverBrush}" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header / branding -->
        <Border Grid.Row="0"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource PanelBorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="24,14">
            <StackPanel>
                <TextBlock Text="Open Rails"
                           FontSize="20" FontWeight="SemiBold"
                           Foreground="{StaticResource PrimaryTextBrush}" />
                <TextBlock Text="Modern Launcher"
                           FontSize="12"
                           Foreground="{StaticResource SecondaryTextBrush}" />
            </StackPanel>
        </Border>

        <!-- Content: profile/route list + route detail -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="360" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Left: profile selector and route cards -->
            <Border Grid.Column="0"
                    Background="{StaticResource SurfaceAltBrush}"
                    BorderBrush="{StaticResource PanelBorderBrush}"
                    BorderThickness="0,0,1,0"
                    Padding="16">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                        <TextBlock Text="Game Library"
                                   FontSize="11" Margin="0,0,0,5"
                                   Foreground="{StaticResource SecondaryTextBrush}" />
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ComboBox Grid.Column="0"
                                      ItemsSource="{Binding Folders}"
                                      SelectedItem="{Binding SelectedFolder, Mode=TwoWay}"
                                      DisplayMemberPath="Name"
                                      IsEnabled="{Binding CanChangeFolder}" />
                            <Button Grid.Column="1" Content="+" Width="34" Margin="6,0,0,0"
                                    Padding="0" FontSize="16"
                                    Click="AddFolder_Click"
                                    ToolTip="Add a game library folder (the one containing ROUTES and TRAINS)" />
                        </Grid>

                        <TextBlock Text="Choose a Route"
                                   FontSize="11" Margin="0,0,0,5"
                                   Foreground="{StaticResource SecondaryTextBrush}" />
                        <Grid>
                            <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="Filter routes by name or description" />
                            <TextBlock Text="Search routes..."
                                       Margin="12,0,0,0"
                                       VerticalAlignment="Center"
                                       IsHitTestVisible="False"
                                       Foreground="{StaticResource SecondaryTextBrush}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SearchText}" Value="">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </StackPanel>

                    <ListBox ItemsSource="{Binding RoutesView}"
                             SelectedItem="{Binding SelectedRoute, Mode=TwoWay}"
                             ItemContainerStyle="{StaticResource RouteItemContainer}"
                             Background="Transparent"
                             BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource SurfaceBrush}"
                                        BorderBrush="{StaticResource PanelBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="12,10">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}"
                                                   FontSize="14" FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis"
                                                   Foreground="{StaticResource PrimaryTextBrush}" />
                                        <TextBlock Text="{Binding Description}"
                                                   FontSize="11" Margin="0,4,0,0" MaxHeight="30"
                                                   TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                                                   Foreground="{StaticResource SecondaryTextBrush}" />
                                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                            <TextBlock FontSize="11"
                                                       Foreground="{StaticResource AccentBrush}"
                                                       Text="{Binding PathCount, StringFormat={}{0} paths, TargetNullValue=—}" />
                                            <TextBlock FontSize="11" Margin="10,0,0,0"
                                                       Foreground="{StaticResource SecondaryTextBrush}"
                                                       Text="{Binding ActivityCount, StringFormat={}{0} activities, TargetNullValue=—}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- Right: route detail -->
            <Grid Grid.Column="1">
                <!-- Empty state -->
                <TextBlock Text="{Binding EmptyStateMessage}"
                           FontSize="14" MaxWidth="520" TextAlignment="Center" TextWrapping="Wrap"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="{StaticResource SecondaryTextBrush}"
                           Visibility="{Binding ShowEmptyState, Converter={StaticResource BoolToVis}}" />

                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              Padding="24">
                    <ScrollViewer.Style>
                        <Style TargetType="ScrollViewer">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedRoute}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ScrollViewer.Style>
                    <StackPanel MaxWidth="820" HorizontalAlignment="Left">
                        <!-- Hero artwork / themed fallback banner -->
                        <TextBlock Text="Your Route" Style="{StaticResource SectionLabel}" Margin="0,0,0,6" />
                        <Border Height="220" CornerRadius="10"
                                BorderBrush="{StaticResource PanelBorderBrush}"
                                BorderThickness="1"
                                ClipToBounds="True">
                            <Grid>
                                <Grid.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#1E1E1E" Offset="0" />
                                        <GradientStop Color="#232B36" Offset="1" />
                                    </LinearGradientBrush>
                                </Grid.Background>
                                <TextBlock Text="OPEN RAILS"
                                           FontSize="28" FontWeight="Bold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Foreground="#2E3946" />
                                <Image Source="{Binding SelectedRoute.HeroImage}"
                                       Stretch="UniformToFill"
                                       Visibility="{Binding SelectedRoute.HasHeroImage, Converter={StaticResource BoolToVis}}" />
                            </Grid>
                        </Border>

                        <TextBlock Text="{Binding SelectedRoute.Name}"
                                   FontSize="26" FontWeight="SemiBold" Margin="0,18,0,0"
                                   TextWrapping="Wrap"
                                   Foreground="{StaticResource PrimaryTextBrush}" />

                        <TextBlock Text="{Binding SelectedRoute.FolderPath}"
                                   FontSize="11" Margin="0,4,0,0"
                                   TextTrimming="CharacterEllipsis"
                                   Foreground="{StaticResource SecondaryTextBrush}" />

                        <!-- Discovery badges -->
                        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                            <Border Style="{StaticResource BadgeBorder}">
                                <TextBlock FontSize="12"
                                           Text="{Binding SelectedRoute.PathCount, StringFormat={}{0} starting places, TargetNullValue=Looking for places…}" />
                            </Border>
                            <Border Style="{StaticResource BadgeBorder}">
                                <TextBlock FontSize="12"
                                           Text="{Binding SelectedRoute.ActivityCount, StringFormat={}{0} missions, TargetNullValue=Looking for missions…}" />
                            </Border>
                        </StackPanel>

                        <TextBlock Text="About this route"
                                   FontSize="11" Margin="0,22,0,6"
                                   Foreground="{StaticResource SecondaryTextBrush}" />
                        <Border Background="{StaticResource SurfaceAltBrush}"
                                BorderBrush="{StaticResource PanelBorderBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="14">
                            <TextBlock Text="{Binding SelectedRoute.Description}"
                                       FontSize="12.5" TextWrapping="Wrap"
                                       Foreground="{StaticResource PrimaryTextBrush}" />
                        </Border>

                        <!-- Mode switcher -->
                        <StackPanel Orientation="Horizontal" Margin="0,22,0,0">
                            <ToggleButton Style="{StaticResource SegmentedToggle}" Content="Quick Drive"
                                          IsChecked="{Binding IsQuickDriveMode, Mode=TwoWay}" />
                            <ToggleButton Style="{StaticResource SegmentedToggle}" Content="Missions"
                                          IsChecked="{Binding IsActivityMode, Mode=TwoWay}" />
                            <ToggleButton Style="{StaticResource SegmentedToggle}" Content="Timetables"
                                          IsChecked="{Binding IsTimetableMode, Mode=TwoWay}" />
                        </StackPanel>

                        <!-- ==================== Quick Drive ==================== -->
                        <StackPanel Visibility="{Binding IsQuickDriveMode, Converter={StaticResource BoolToVis}}">

                            <!-- Card 2: the train -->
                            <Border Style="{StaticResource CardBorder}" Margin="0,18,0,14">
                                <StackPanel>
                                    <DockPanel>
                                        <Border DockPanel.Dock="Right" Style="{StaticResource BadgeBorder}"
                                                VerticalAlignment="Center">
                                            <TextBlock FontSize="11" Foreground="{StaticResource AccentBrush}">
                                                <Run Text="{Binding SelectedConsist.CarCount, Mode=OneWay, TargetNullValue=?}" />
                                                <Run Text=" cars" />
                                            </TextBlock>
                                        </Border>
                                        <TextBlock Text="Your Train" FontSize="13" FontWeight="SemiBold"
                                                   VerticalAlignment="Center"
                                                   Foreground="{StaticResource PrimaryTextBrush}" />
                                    </DockPanel>

                                    <TextBlock FontSize="17" FontWeight="SemiBold" Margin="0,8,0,0"
                                               TextTrimming="CharacterEllipsis"
                                               Foreground="{StaticResource AccentBrush}"
                                               Text="{Binding SelectedConsist.LocomotiveName, FallbackValue=No train selected yet, TargetNullValue=No train selected yet}" />
                                    <TextBlock FontSize="11.5" Margin="0,2,0,0"
                                               TextTrimming="CharacterEllipsis"
                                               Foreground="{StaticResource SecondaryTextBrush}"
                                               Text="{Binding SelectedConsist.Name, FallbackValue=—, TargetNullValue=—}" />

                                    <TextBlock Text="Search or pick another train" Style="{StaticResource SectionLabel}"
                                               Margin="0,14,0,6" />
                                    <Grid>
                                        <TextBox Text="{Binding ConsistSearchText, UpdateSourceTrigger=PropertyChanged}"
                                                 ToolTip="Filter trains by name or locomotive" />
                                        <TextBlock Text="Search trains..."
                                                   Margin="12,0,0,0"
                                                   VerticalAlignment="Center"
                                                   IsHitTestVisible="False"
                                                   Foreground="{StaticResource SecondaryTextBrush}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ConsistSearchText}" Value="">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>

                                    <ListBox Margin="0,8,0,0"
                                             ItemsSource="{Binding ConsistsView}"
                                             SelectedItem="{Binding SelectedConsist, Mode=TwoWay}"
                                             ItemContainerStyle="{StaticResource RouteItemContainer}"
                                             Background="Transparent" BorderThickness="0"
                                             MaxHeight="240"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{StaticResource SurfaceBrush}"
                                                        BorderBrush="{StaticResource PanelBorderBrush}"
                                                        BorderThickness="1" CornerRadius="8" Padding="12,10">
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding LocomotiveName}"
                                                                   FontSize="13" FontWeight="SemiBold"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   Foreground="{StaticResource PrimaryTextBrush}" />
                                                        <TextBlock Text="{Binding Name}"
                                                                   FontSize="11" Margin="0,3,0,0"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   Foreground="{StaticResource SecondaryTextBrush}" />
                                                        <TextBlock FontSize="11" Margin="0,3,0,0"
                                                                   Foreground="{StaticResource AccentBrush}">
                                                            <Run Text="{Binding LocomotiveType, Mode=OneWay, TargetNullValue=Unknown type}" />
                                                            <Run Text=" · " />
                                                            <Run Text="{Binding CarCount, Mode=OneWay, TargetNullValue=?}" />
                                                            <Run Text=" cars" />
                                                        </TextBlock>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </StackPanel>
                            </Border>

                            <!-- Card 3: where the drive begins -->
                            <Border Style="{StaticResource CardBorder}">
                                <StackPanel>
                                    <TextBlock Text="Starting Location" FontSize="13" FontWeight="SemiBold"
                                               Foreground="{StaticResource PrimaryTextBrush}" />
                                    <TextBlock Text="Where your drive begins and ends."
                                               FontSize="11" Margin="0,2,0,10"
                                               Foreground="{StaticResource SecondaryTextBrush}" />
                                    <ComboBox ItemsSource="{Binding Paths}"
                                              SelectedItem="{Binding SelectedPath, Mode=TwoWay}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="From" FontSize="11"
                                                               VerticalAlignment="Center"
                                                               Foreground="{StaticResource SecondaryTextBrush}" />
                                                    <TextBlock Text="{Binding StartStation}" Margin="6,0,0,0" />
                                                    <TextBlock Text="→" Margin="8,0"
                                                               Foreground="{StaticResource SecondaryTextBrush}" />
                                                    <TextBlock Text="To" FontSize="11"
                                                               VerticalAlignment="Center"
                                                               Foreground="{StaticResource SecondaryTextBrush}" />
                                                    <TextBlock Text="{Binding EndStation}" Margin="6,0,0,0" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </StackPanel>
                            </Border>

                            <!-- Card 4: environment -->
                            <Border Style="{StaticResource CardBorder}">
                                <StackPanel>
                                    <TextBlock Text="Time &amp; Weather" FontSize="13" FontWeight="SemiBold"
                                               Foreground="{StaticResource PrimaryTextBrush}" />

                                    <TextBlock Text="Time of day" Style="{StaticResource SectionLabel}" Margin="0,14,0,6" />
                                    <ListBox ItemsSource="{Binding TimeOptions}"
                                             SelectedItem="{Binding SelectedTimeOption, Mode=TwoWay}"
                                             ItemContainerStyle="{StaticResource PillItemContainer}"
                                             Background="Transparent" BorderThickness="0"
                                             HorizontalAlignment="Left"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                        <ListBox.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" />
                                            </ItemsPanelTemplate>
                                        </ListBox.ItemsPanel>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock>
                                                    <Run Text="{Binding Icon, Mode=OneWay}" />
                                                    <Run Text="  " />
                                                    <Run Text="{Binding Label, Mode=OneWay}" />
                                                </TextBlock>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>

                                    <TextBlock Text="Weather" Style="{StaticResource SectionLabel}" Margin="0,14,0,6" />
                                    <ListBox ItemsSource="{Binding WeatherOptions}"
                                             SelectedItem="{Binding SelectedWeatherOption, Mode=TwoWay}"
                                             ItemContainerStyle="{StaticResource PillItemContainer}"
                                             Background="Transparent" BorderThickness="0"
                                             HorizontalAlignment="Left"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                        <ListBox.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" />
                                            </ItemsPanelTemplate>
                                        </ListBox.ItemsPanel>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock>
                                                    <Run Text="{Binding Icon, Mode=OneWay}" />
                                                    <Run Text="  " />
                                                    <Run Text="{Binding Label, Mode=OneWay}" />
                                                </TextBlock>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>

                                    <TextBlock Text="Season" Style="{StaticResource SectionLabel}" Margin="0,14,0,6" />
                                    <ListBox ItemsSource="{Binding SeasonOptions}"
                                             SelectedItem="{Binding SelectedSeasonOption, Mode=TwoWay}"
                                             ItemContainerStyle="{StaticResource PillItemContainer}"
                                             Background="Transparent" BorderThickness="0"
                                             HorizontalAlignment="Left"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                        <ListBox.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" />
                                            </ItemsPanelTemplate>
                                        </ListBox.ItemsPanel>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock>
                                                    <Run Text="{Binding Icon, Mode=OneWay}" />
                                                    <Run Text="  " />
                                                    <Run Text="{Binding Label, Mode=OneWay}" />
                                                </TextBlock>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- ==================== Missions ==================== -->
                        <StackPanel Margin="0,18,0,0"
                                    Visibility="{Binding IsActivityMode, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="Available missions" Style="{StaticResource SectionLabel}" />
                            <ListBox ItemsSource="{Binding Activities}"
                                     SelectedItem="{Binding SelectedActivity, Mode=TwoWay}"
                                     ItemContainerStyle="{StaticResource RouteItemContainer}"
                                     Background="Transparent" BorderThickness="0"
                                     MaxHeight="440"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource SurfaceBrush}"
                                                BorderBrush="{StaticResource PanelBorderBrush}"
                                                BorderThickness="1" CornerRadius="8" Padding="12,10">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Name}"
                                                           FontSize="14" FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis"
                                                           Foreground="{StaticResource PrimaryTextBrush}" />
                                                <TextBlock FontSize="11" Margin="0,4,0,0"
                                                           Foreground="{StaticResource AccentBrush}">
                                                    <Run Text="{Binding Difficulty, Mode=OneWay}" />
                                                    <Run Text=" · " />
                                                    <Run Text="{Binding Duration, Mode=OneWay}" />
                                                    <Run Text=" · departs " />
                                                    <Run Text="{Binding StartTime, Mode=OneWay}" />
                                                </TextBlock>
                                                <TextBlock Text="{Binding Description}"
                                                           FontSize="11.5" Margin="0,6,0,0" TextWrapping="Wrap"
                                                           Foreground="{StaticResource SecondaryTextBrush}" />
                                                <TextBlock Text="{Binding Briefing}"
                                                           FontSize="11.5" Margin="0,6,0,0" TextWrapping="Wrap"
                                                           Foreground="#9AA4B2"
                                                           Visibility="{Binding HasBriefing, Converter={StaticResource BoolToVis}}" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </StackPanel>

                        <!-- ==================== Timetable mode ==================== -->
                        <StackPanel Margin="0,18,0,0"
                                    Visibility="{Binding IsTimetableMode, Converter={StaticResource BoolToVis}}">
                            <Border Style="{StaticResource CardBorder}">
                                <TextBlock FontSize="12" TextWrapping="Wrap"
                                           Foreground="{StaticResource SecondaryTextBrush}"
                                           Text="Timetables are not wired up yet; they arrive in a later milestone." />
                            </Border>
                        </StackPanel>

                        <!-- ==================== Launch ==================== -->
                        <StackPanel Margin="0,6,0,0">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsTimetableMode}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>

                            <Button Style="{StaticResource PrimaryActionButton}"
                                    Content="{Binding LaunchButtonLabel}"
                                    Click="DriveNow_Click"
                                    HorizontalAlignment="Stretch" />

                            <Border Margin="0,10,0,0" CornerRadius="8" Padding="12,9"
                                    Background="#2E2113" BorderBrush="#7C5A24" BorderThickness="1">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding LaunchProblem}" Value="">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="{Binding LaunchProblem}"
                                           FontSize="12" TextWrapping="Wrap"
                                           Foreground="#F0C27B" />
                            </Border>

                            <TextBlock Text="Tip: hold Alt while clicking to copy the launch command instead (testing aid)."
                                       FontSize="10.5" Margin="0,8,0,0" TextWrapping="Wrap"
                                       Foreground="{StaticResource SecondaryTextBrush}" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>

        <!-- Status bar -->
        <Border Grid.Row="2"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource PanelBorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="24,10">
            <DockPanel>
                <TextBlock DockPanel.Dock="Right"
                           FontSize="12"
                           Foreground="{StaticResource SecondaryTextBrush}"
                           Text="{Binding StatusMessage}" />
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock FontSize="12" Margin="0,0,16,0"
                               Foreground="{StaticResource SecondaryTextBrush}"
                               Text="{Binding Folders.Count, StringFormat={}{0} libraries}" />
                    <TextBlock FontSize="12" Margin="0,0,16,0"
                               Foreground="{StaticResource SecondaryTextBrush}"
                               Text="{Binding Routes.Count, StringFormat={}{0} routes}" />
                    <ProgressBar Width="90" Height="4" IsIndeterminate="True"
                                 VerticalAlignment="Center"
                                 Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}" />
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
