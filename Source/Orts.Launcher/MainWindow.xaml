<Window x:Class="Orts.Launcher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Open Rails"
        Width="1180" Height="760"
        MinWidth="1040" MinHeight="700"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBackgroundBrush}"
        Foreground="{StaticResource PrimaryTextBrush}"
        FontFamily="{StaticResource GoogleSansFlex}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display">
    <Window.Resources>
        <Style x:Key="RouteItemContainer" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Root"
                                Background="Transparent"
                                CornerRadius="2"
                                BorderThickness="1"
                                BorderBrush="Transparent">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#161616" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="Root" Property="Background" Value="#0B1622" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Micro-label used above a control. -->
        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
        </Style>

        <!-- Small uppercase heading at the top of a card. -->
        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
        </Style>

        <!-- Key/value rows inside a card. -->
        <Style x:Key="SpecLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,14,0" />
        </Style>

        <Style x:Key="SpecValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="HairLine" TargetType="Border">
            <Setter Property="Height" Value="1" />
            <Setter Property="Background" Value="{StaticResource PanelBorderBrush}" />
            <Setter Property="Margin" Value="0,14" />
        </Style>

        <Style x:Key="CardBorder" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SurfaceAltBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource PanelBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="2" />
            <Setter Property="Padding" Value="18" />
        </Style>

        <DataTemplate x:Key="PillTemplate">
            <TextBlock>
                <Run Text="{Binding Icon, Mode=OneWay}" />
                <Run Text=" " />
                <Run Text="{Binding Label, Mode=OneWay}" />
            </TextBlock>
        </DataTemplate>

        <!-- A ListBox used as a radio group: this is the pill look for the environment choices. -->
        <Style x:Key="PillItemContainer" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd"
                                Background="{StaticResource SurfaceBrush}"
                                BorderBrush="{StaticResource PanelBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="2"
                                Padding="9,5">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource PanelBorderBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentSolidBrush}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentSolidBrush}" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- One horizontal pill row; the choice itself comes from the bound ItemSource. -->
        <Style x:Key="PillRow" TargetType="ListBox">
            <Setter Property="ItemContainerStyle" Value="{StaticResource PillItemContainer}" />
            <Setter Property="ItemTemplate" Value="{StaticResource PillTemplate}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ItemsPanel">
                <Setter.Value>
                    <!-- Wraps instead of clipping when the window is narrow. -->
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header / branding -->
        <Border Grid.Row="0"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource PanelBorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="24,14">
            <StackPanel>
                <TextBlock Text="Open Rails"
                           FontSize="20" FontWeight="SemiBold"
                           Foreground="{StaticResource PrimaryTextBrush}" />
                <TextBlock Text="Modern Launcher"
                           FontSize="12"
                           Foreground="{StaticResource SecondaryTextBrush}" />
            </StackPanel>
        </Border>

        <!-- Content: profile/route list + driving deck -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="330" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Left: profile selector and route cards -->
            <Border Grid.Column="0"
                    Background="{StaticResource SurfaceAltBrush}"
                    BorderBrush="{StaticResource PanelBorderBrush}"
                    BorderThickness="0,0,1,0"
                    Padding="16">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                        <TextBlock Text="GAME LIBRARY"
                                   Style="{StaticResource SectionLabel}" Margin="0,0,0,8" />
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ComboBox Grid.Column="0"
                                      ItemsSource="{Binding Folders}"
                                      SelectedItem="{Binding SelectedFolder, Mode=TwoWay}"
                                      DisplayMemberPath="Name"
                                      IsEnabled="{Binding CanChangeFolder}" />
                            <Button Grid.Column="1" Content="+" Width="34" Margin="6,0,0,0"
                                    Padding="0" FontSize="16"
                                    Click="AddFolder_Click"
                                    ToolTip="Add a game library folder (the one containing ROUTES and TRAINS)" />
                        </Grid>

                        <TextBlock Text="CHOOSE A ROUTE"
                                   Style="{StaticResource SectionLabel}" Margin="0,0,0,8" />
                        <Grid>
                            <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="Filter routes by name or description" />
                            <TextBlock Text="Search routes..."
                                       Margin="12,0,0,0"
                                       VerticalAlignment="Center"
                                       IsHitTestVisible="False"
                                       Foreground="{StaticResource SecondaryTextBrush}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SearchText}" Value="">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </StackPanel>

                    <ListBox ItemsSource="{Binding RoutesView}"
                             SelectedItem="{Binding SelectedRoute, Mode=TwoWay}"
                             ItemContainerStyle="{StaticResource RouteItemContainer}"
                             Background="Transparent"
                             BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource SurfaceBrush}"
                                        BorderBrush="{StaticResource PanelBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="2"
                                        Padding="12,10">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}"
                                                   FontSize="14" FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis"
                                                   Foreground="{StaticResource PrimaryTextBrush}" />
                                        <TextBlock Text="{Binding Description}"
                                                   FontSize="11" Margin="0,4,0,0" MaxHeight="30"
                                                   TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                                                   Foreground="{StaticResource SecondaryTextBrush}" />
                                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                            <TextBlock FontSize="11"
                                                       Foreground="{StaticResource AccentBrush}"
                                                       Text="{Binding PathCount, StringFormat={}Starting points: {0}, TargetNullValue=—}" />
                                            <TextBlock FontSize="11" Margin="10,0,0,0"
                                                       Foreground="{StaticResource SecondaryTextBrush}"
                                                       Text="{Binding ActivityCount, StringFormat={}Missions: {0}, TargetNullValue=—}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- Right: the driving deck. Three rows, so the Drive button is always on screen. -->
            <Grid Grid.Column="1">
                <!-- Empty state -->
                <TextBlock Text="{Binding EmptyStateMessage}"
                           FontSize="14" MaxWidth="520" TextAlignment="Center" TextWrapping="Wrap"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="{StaticResource SecondaryTextBrush}"
                           Visibility="{Binding ShowEmptyState, Converter={StaticResource BoolToVis}}" />

                <Grid Margin="22,18,22,16">
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedRoute}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Row 1: which route, and which panel -->
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Column="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Hero artwork, or the themed banner when the route ships none -->
                            <Border Grid.Column="0" Width="128" Height="70" CornerRadius="2"
                                    BorderBrush="{StaticResource PanelBorderBrush}"
                                    BorderThickness="1"
                                    ClipToBounds="True">
                                <Grid>
                                    <Grid.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#0D0D0D" Offset="0" />
                                            <GradientStop Color="#101820" Offset="1" />
                                        </LinearGradientBrush>
                                    </Grid.Background>
                                    <TextBlock Text="OPEN RAILS"
                                               FontSize="11" FontWeight="Bold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Foreground="#2A3542" />
                                    <Image Source="{Binding SelectedRoute.HeroImage}"
                                           Stretch="UniformToFill"
                                           Visibility="{Binding SelectedRoute.HasHeroImage, Converter={StaticResource BoolToVis}}" />
                                </Grid>
                            </Border>

                            <StackPanel Grid.Column="1" Margin="14,0,12,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding SelectedRoute.Name}"
                                           FontSize="21" FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis"
                                           Foreground="{StaticResource PrimaryTextBrush}" />
                                <TextBlock Text="{Binding SelectedRoute.FolderPath}"
                                           FontSize="11" Margin="0,3,0,0"
                                           TextTrimming="CharacterEllipsis"
                                           Foreground="{StaticResource SecondaryTextBrush}" />
                            </StackPanel>
                        </Grid>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <ToggleButton Style="{StaticResource SegmentedToggle}" Content="Quick Drive"
                                          IsChecked="{Binding IsQuickDriveMode, Mode=TwoWay}" />
                            <ToggleButton Style="{StaticResource SegmentedToggle}" Content="Missions"
                                          IsChecked="{Binding IsActivityMode, Mode=TwoWay}" />
                            <ToggleButton Style="{StaticResource SegmentedToggle}" Content="Timetable"
                                          IsChecked="{Binding IsTimetableMode, Mode=TwoWay}" />
                        </StackPanel>
                    </Grid>

                    <!-- Row 2: setup -->
                    <Grid Grid.Row="1" Margin="0,16,0,0">
                        <!-- Quick Drive -->
                        <Grid Visibility="{Binding IsQuickDriveMode, Converter={StaticResource BoolToVis}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Your Train -->
                            <Border Grid.Column="0" Style="{StaticResource CardBorder}" Margin="0,0,8,0">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Text="YOUR TRAIN" Style="{StaticResource CardTitle}" />

                                    <!-- Chosen locomotive and its specs, centred between the title and the picker. -->
                                    <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="0,16">
                                        <TextBlock FontSize="24" FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis"
                                                   Foreground="{StaticResource PrimaryTextBrush}"
                                                   Text="{Binding SelectedConsist.LocomotiveName, FallbackValue=No train selected yet, TargetNullValue=No train selected yet}" />
                                        <TextBlock Margin="0,6,0,0" FontSize="12"
                                                   TextTrimming="CharacterEllipsis"
                                                   Foreground="{StaticResource SecondaryTextBrush}"
                                                   Text="{Binding SelectedConsist.Name, FallbackValue=—, TargetNullValue=—}" />

                                        <Border Style="{StaticResource HairLine}" Margin="0,18,0,16" />

                                        <Grid Margin="0,0,0,12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="86" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="CAR COUNT" Style="{StaticResource SpecLabel}" />
                                            <TextBlock Grid.Column="1" Style="{StaticResource SpecValue}"
                                                       Text="{Binding SelectedConsist.CarCountLabel, FallbackValue=—, TargetNullValue=—}" />
                                        </Grid>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="86" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="DEPARTURE" Style="{StaticResource SpecLabel}" />
                                            <TextBlock Grid.Column="1" Style="{StaticResource SpecValue}"
                                                       Text="{Binding SelectedPath.Label, FallbackValue=Not set, TargetNullValue=Not set}" />
                                        </Grid>
                                    </StackPanel>

                                    <StackPanel Grid.Row="2">
                                        <TextBlock Text="CHANGE TRAIN" Style="{StaticResource CardTitle}"
                                                   Margin="0,0,0,8" />
                                        <ComboBox ItemsSource="{Binding Consists}"
                                                  SelectedItem="{Binding SelectedConsist, Mode=TwoWay}"
                                                  TextSearch.TextPath="LocomotiveName"
                                                  ToolTip="Pick the train you want to drive; type to search">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <DockPanel>
                                                        <TextBlock DockPanel.Dock="Right" Margin="14,0,0,0"
                                                                   Foreground="{StaticResource SecondaryTextBrush}">
                                                            <Run Text="{Binding CarCount, Mode=OneWay, TargetNullValue=?}" /><Run Text=" cars" />
                                                        </TextBlock>
                                                        <TextBlock Text="{Binding LocomotiveName}"
                                                                   TextTrimming="CharacterEllipsis" />
                                                    </DockPanel>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Conditions & start -->
                            <Border Grid.Column="1" Style="{StaticResource CardBorder}" Margin="8,0,0,0">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Text="CONDITIONS &amp; START"
                                               Style="{StaticResource CardTitle}" />

                                    <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="0,8,0,0">
                                        <TextBlock Text="DEPARTURE" Style="{StaticResource SectionLabel}" />
                                        <ComboBox ItemsSource="{Binding Paths}"
                                                  SelectedItem="{Binding SelectedPath, Mode=TwoWay}"
                                                  ToolTip="Where your drive begins and ends">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" />
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </StackPanel>

                                    <StackPanel Grid.Row="2" VerticalAlignment="Center" Margin="0,8,0,0">
                                        <TextBlock Text="TIME OF DAY" Style="{StaticResource SectionLabel}" />
                                        <ListBox Style="{StaticResource PillRow}"
                                                 ItemsSource="{Binding TimeOptions}"
                                                 SelectedItem="{Binding SelectedTimeOption, Mode=TwoWay}" />
                                    </StackPanel>

                                    <StackPanel Grid.Row="3" VerticalAlignment="Center" Margin="0,8,0,0">
                                        <TextBlock Text="WEATHER" Style="{StaticResource SectionLabel}" />
                                        <ListBox Style="{StaticResource PillRow}"
                                                 ItemsSource="{Binding WeatherOptions}"
                                                 SelectedItem="{Binding SelectedWeatherOption, Mode=TwoWay}" />
                                    </StackPanel>

                                    <StackPanel Grid.Row="4" VerticalAlignment="Center" Margin="0,8,0,0">
                                        <TextBlock Text="SEASON" Style="{StaticResource SectionLabel}" />
                                        <ListBox Style="{StaticResource PillRow}"
                                                 ItemsSource="{Binding SeasonOptions}"
                                                 SelectedItem="{Binding SelectedSeasonOption, Mode=TwoWay}" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>

                        <!-- Missions -->
                        <Border Visibility="{Binding IsActivityMode, Converter={StaticResource BoolToVis}}"
                                Style="{StaticResource CardBorder}">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top" Text="MISSIONS"
                                           Style="{StaticResource CardTitle}" />
                                <TextBlock DockPanel.Dock="Top"
                                           Text="Pick a mission to run, then press Start Mission."
                                           FontSize="11.5" Margin="0,6,0,12"
                                           Foreground="{StaticResource SecondaryTextBrush}" />
                                <ListBox ItemsSource="{Binding Activities}"
                                         SelectedItem="{Binding SelectedActivity, Mode=TwoWay}"
                                         ItemContainerStyle="{StaticResource RouteItemContainer}"
                                         Background="Transparent" BorderThickness="0"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{StaticResource SurfaceBrush}"
                                                    BorderBrush="{StaticResource PanelBorderBrush}"
                                                    BorderThickness="1" CornerRadius="2" Padding="12,10">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Name}"
                                                               FontSize="14" FontWeight="SemiBold"
                                                               TextTrimming="CharacterEllipsis"
                                                               Foreground="{StaticResource PrimaryTextBrush}" />
                                                    <TextBlock FontSize="11" Margin="0,4,0,0"
                                                               Foreground="{StaticResource AccentBrush}">
                                                        <Run Text="{Binding Difficulty, Mode=OneWay}" />
                                                        <Run Text=" · " />
                                                        <Run Text="{Binding Duration, Mode=OneWay}" />
                                                        <Run Text=" · departs " />
                                                        <Run Text="{Binding StartTime, Mode=OneWay}" />
                                                    </TextBlock>
                                                    <TextBlock Text="{Binding Description}"
                                                               FontSize="11.5" Margin="0,6,0,0" TextWrapping="Wrap"
                                                               Foreground="{StaticResource SecondaryTextBrush}" />
                                                    <TextBlock Text="{Binding Briefing}"
                                                               FontSize="11.5" Margin="0,6,0,0" TextWrapping="Wrap"
                                                               Foreground="{StaticResource SecondaryTextBrush}"
                                                               Visibility="{Binding HasBriefing, Converter={StaticResource BoolToVis}}" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </DockPanel>
                        </Border>

                        <!-- Timetable -->
                        <Border Visibility="{Binding IsTimetableMode, Converter={StaticResource BoolToVis}}"
                                Style="{StaticResource CardBorder}"
                                VerticalAlignment="Top">
                            <TextBlock FontSize="12" TextWrapping="Wrap"
                                       Foreground="{StaticResource SecondaryTextBrush}"
                                       Text="Timetables are not wired up yet; they arrive in a later milestone." />
                        </Border>
                    </Grid>

                    <!-- Row 3: pinned action footer -->
                    <Grid Grid.Row="2" Margin="0,16,0,0">
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsTimetableMode}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="{Binding DeckStatusText}"
                                   Margin="2,0,18,0"
                                   FontSize="12" TextWrapping="Wrap"
                                   VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding DeckStatusIsWarning}" Value="True">
                                            <Setter Property="Foreground" Value="#F0C27B" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <StackPanel Grid.Column="1">
                            <Button Style="{StaticResource PrimaryActionButton}"
                                    Content="{Binding LaunchButtonLabel}"
                                    Click="DriveNow_Click"
                                    MinWidth="270" />
                            <TextBlock Text="Alt + Click to copy the launch command"
                                       FontSize="10.5" Margin="0,7,2,0"
                                       HorizontalAlignment="Right"
                                       Foreground="{StaticResource SecondaryTextBrush}" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>

        <!-- Status bar -->
        <Border Grid.Row="2"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource PanelBorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="24,10">
            <DockPanel>
                <TextBlock DockPanel.Dock="Right"
                           FontSize="12"
                           Foreground="{StaticResource SecondaryTextBrush}"
                           Text="{Binding StatusMessage}" />
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock FontSize="12" Margin="0,0,16,0"
                               Foreground="{StaticResource SecondaryTextBrush}"
                               Text="{Binding Folders.Count, StringFormat={}Libraries: {0}}" />
                    <TextBlock FontSize="12" Margin="0,0,16,0"
                               Foreground="{StaticResource SecondaryTextBrush}"
                               Text="{Binding Routes.Count, StringFormat={}Routes: {0}}" />
                    <ProgressBar Width="90" Height="4" IsIndeterminate="True"
                                 VerticalAlignment="Center"
                                 Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}" />
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
