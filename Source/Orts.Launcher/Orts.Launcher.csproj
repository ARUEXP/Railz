<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- WinForms is enabled only for its FolderBrowserDialog, which the legacy Menu also uses. -->
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <!-- Target .NET 10 desktop runtime natively with major rollforward support. -->
    <RollForward>Major</RollForward>
    <AssemblyTitle>Open Rails Modern Launcher</AssemblyTitle>
    <Description>Open Rails Transport Simulator</Description>
    <Company>Open Rails</Company>
    <Product>Open Rails</Product>
    <Copyright>Copyright © 2009 - 2022</Copyright>
    <PackageLicenseExpression>GPL-3.0-or-later</PackageLicenseExpression>
  </PropertyGroup>

  <ItemGroup>
    <!-- Google Sans Flex, compiled into the assembly as a WPF font resource. -->
    <Resource Include="Resources\Fonts\GoogleSansFlex-VariableFont.ttf" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Orts.Common\Orts.Common.csproj" />
    <ProjectReference Include="..\Orts.Settings\Orts.Settings.csproj" />
    <ProjectReference Include="..\Orts.Menu\Orts.Menu.csproj" />
    <ProjectReference Include="..\Orts.Content\Orts.Content.csproj" />
  </ItemGroup>

</Project>
